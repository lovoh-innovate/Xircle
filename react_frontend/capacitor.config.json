{
  "appId": "com.lovohcreate.xircle",
  "appName": "Xircle",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "xircle.lovohcreate.com",
      "accounts.google.com",
      "*.googleapis.com"
    ]
  },
  "plugins": {
    "Browser": {
      "presentationStyle": "fullscreen",
      "preferredMode": "single"
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "596946698879-m4hqsvm5iionnlq33903g5tk5b78k5tv.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#ff0a0a0f",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}